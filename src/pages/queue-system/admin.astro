---
import Layout from '../../layouts/Layout.astro';
import AdminQueueManager from '../../components/AdminQueueManager.tsx';
---

<Layout title="Quản lý hàng đợi - Admin">
  <main class="min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-8">
      <!-- Header -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Quản lý hàng đợi</h1>
          <p class="text-gray-600 mt-2">Theo dõi và quản lý hệ thống xếp hàng tự động</p>
        </div>
        <a 
          href="/queue-system" 
          class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Quay lại trang chính
        </a>
      </div>

      <!-- Admin Controls -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Statistics Cards -->
        <div class="bg-white rounded-xl shadow-lg p-6">
          <div class="flex items-center">
            <div class="p-3 bg-blue-100 rounded-lg">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-600">Tổng trong hàng</p>
              <p class="text-2xl font-semibold text-gray-900" id="total-in-queue">0</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-6">
          <div class="flex items-center">
            <div class="p-3 bg-green-100 rounded-lg">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-600">Đang phục vụ</p>
              <p class="text-2xl font-semibold text-gray-900" id="currently-serving">0</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-6">
          <div class="flex items-center">
            <div class="p-3 bg-yellow-100 rounded-lg">
              <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-600">Thời gian chờ TB</p>
              <p class="text-2xl font-semibold text-gray-900" id="avg-wait-time">0</p>
              <p class="text-xs text-gray-500">phút</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Queue Management -->
      <div class="bg-white rounded-xl shadow-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900">Danh sách hàng đợi</h2>
        </div>
        <div class="p-6">
          <div id="admin-queue-manager">
            <AdminQueueManager />
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Update statistics periodically
  async function updateStatistics() {
    try {
      const response = await fetch('/api/queue/status');
      if (response.ok) {
        const data = await response.json();
        document.getElementById('total-in-queue').textContent = data.totalInQueue || 0;
        document.getElementById('currently-serving').textContent = data.currentServing || 0;
        document.getElementById('avg-wait-time').textContent = data.averageWaitTime || 0;
      }
    } catch (error) {
      console.error('Error updating statistics:', error);
    }
  }

  // Update statistics every 5 seconds
  setInterval(updateStatistics, 5000);
  
  // Initial update
  updateStatistics();
</script>